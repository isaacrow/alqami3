<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:bf="http://id.loc.gov/ontologies/bibframe/"
         xmlns:schema="http://schema.org/">
  <bf:Instance rdf:about="https://alqami.net/artifact/bowl">
    <bf:title>
      <bf:Title>
        <bf:mainTitle xml:lang="ar">وعاء أثري</bf:mainTitle>
        <rdfs:label>Ancient Bowl</rdfs:label>
      </bf:Title>
    </bf:title>
    <bf:provisionActivity>
      <bf:ProvisionActivity>
        <bf:date>غير محدد</bf:date>
      </bf:ProvisionActivity>
    </bf:provisionActivity>
    <bf:extent>
      <bf:Extent>
        <rdfs:label xml:lang="ar">متوسط الحجم</rdfs:label>
      </bf:Extent>
    </bf:extent>
    <bf:material>
      <rdfs:label xml:lang="ar">فخار</rdfs:label>
      <rdfs:label xml:lang="en">Pottery / Ceramic</rdfs:label>
    </bf:material>
    <bf:contribution>
      <bf:Contribution>
        <bf:agent>
          <bf:Agent>
            <rdfs:label xml:lang="ar">حرفي غير معروف</rdfs:label>
          </bf:Agent>
        </bf:agent>
      </bf:Contribution>
    </bf:contribution>
    <bf:note>
      <bf:Note>
        <rdfs:label xml:lang="ar">وعاء تاريخي يستخدم للأغراض اليومية، يعكس أسلوب صناعة الفخار في تلك الحقبة.</rdfs:label>
      </bf:Note>
    </bf:note>
  </bf:Instance>
</rdf:RDF>