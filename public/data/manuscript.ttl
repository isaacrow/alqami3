ms:LapisGoldUnwan a ms:IlluminationFeature, crm:E25_Man-Made_Feature ;
    rdfs:label "Illuminated Header (ʿUnwān / ديباجة مذهبة)"@en ;
    dc:description "Intricate polylobed arch headpiece rendered in lapis lazuli (ultramarine blue), turquoise, and 24-karat shell gold with intertwining floral islimi (arabesque) vine scrollwork framing the cartouche."@en ;
    ms:pigments "Lapis lazuli, ground malachite, cinnabar, shell gold leaf"@en ;
    ms:style "Persian / Central Asian Imperial Court Workshop (Safavid-Timurid tradition)"@en .

ms:MajlisLibrarySeal a ms:ProvenanceFeature, crm:E37_Mark ;
    rdfs:label "Majlis Parliament Library Seal (مهر کتابخانه مجلس شورای ملی)"@en ;
    dc:description "Official ownership stamp of the Iranian National Consultative Assembly Library (Ketābkhāneh-ye Majles-e Showrā-ye Mellī), established in 1302 AH / 1923 CE. The seal bears the Iranian lion and sun crest with historical typography."@en ;
    crm:P53_has_former_or_current_location "Tehran, Iran"@en ;
    schema:foundingDate "1302 AH (1923 CE)" .

ms:NaskhFine a ms:CalligraphicScript ;
    rdfs:label "Clear Naskh Calligraphy (خط النسخ الدقيق)"@en ;
    dc:description "Carefully proportioned Naskh script written with a reed pen (qalam) using iron gall ink, providing optimal clarity for philosophical discourse."@en .

ms:NastaliqTaaliqGlosses a ms:CalligraphicScript ;
    rdfs:label "Marginal Nastaliq / Ta'liq Glosses (تعلیقات و حواشی نستعلیق)"@en ;
    dc:description "Scholarly annotations written in diagonal margins (Ḥāshiyah) clarifying subtle metaphysical terms, logical syllogisms, and textual variants."@en .

